# Meltemi Rentals — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed.
# These variables are read only in server code (API route handlers) and are
# never exposed to the browser — do not add the `NEXT_PUBLIC_` prefix.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives rental requests. Any address you own is fine.
RENTAL_REQUEST_EMAIL=hello@meltemirentals.example

# Verified "from" sender for Resend. Must be an address on a domain
# you have verified in Resend (see https://resend.com/domains).
# For local prototyping you may use Resend's sandbox: "onboarding@resend.dev".
RESEND_FROM_EMAIL=Meltemi Rentals <onboarding@resend.dev>
